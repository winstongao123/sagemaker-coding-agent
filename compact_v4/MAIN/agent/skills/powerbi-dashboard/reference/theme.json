{
  "name": "AIPower Regional Sales",
  "dataColors": [
    "#1E3A8A",
    "#2563EB",
    "#60A5FA",
    "#93C5FD",
    "#0F766E",
    "#14B8A6",
    "#0891B2",
    "#38BDF8",
    "#F59E0B",
    "#DC2626"
  ],
  "background": "#F3F6FB",
  "foreground": "#0F172A",
  "tableAccent": "#1E3A8A",
  "good": "#16A34A",
  "neutral": "#2563EB",
  "bad": "#DC2626",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 26
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 13,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D0DAE8"
              }
            },
            "radius": 4
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1E293B"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1E3A8A"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredColumnChart": {
      "*": {
        "labels": [
          {
            "fontSize": 10
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "fontSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ]
      },
      "grid": {
        "gridVertical": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ],
        "gridHorizontal": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "color": {
              "solid": {
                "color": "#0F172A"
              }
            }
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#EEF3FA"
              }
            },
            "transparency": 0
          }
        ],
        "items": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#1E293B"
              }
            }
          }
        ]
      }
    }
  }
}
