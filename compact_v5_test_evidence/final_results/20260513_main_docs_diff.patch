+<project>/compact_v5_wip/
+  AGENT_STATUS.md
+  memory.md
+  docs/
+    logs/
+    reviews/
+  .sageagent_state/
+    todos.json
+    tasks.json
+    gates/
+    tool_results/
+    shell_jobs/
+  sessions/
+  audit_logs/
