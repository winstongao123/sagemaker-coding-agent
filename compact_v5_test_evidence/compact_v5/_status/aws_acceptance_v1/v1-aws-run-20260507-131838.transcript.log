def search_issues(store, query=None, tags=None, status=None) -> list[dict]:
    """Search issues with multiple filters.
    
    Args:
        store: JSONStore instance
        query: Text search query (searches title and description, AND logic)
        tags: List of tags (issue must have ALL specified tags, AND logic)
        status: Status filter ("open", "closed", or None for all)
    
    Returns:
        List of issue dictionaries matching all specified filters.
        Each dictionary contains: id, title, description, status, tags,
        created_at, updated_at.
    
    Example:
        >>> search_issues(store, query="bug login", tags=["auth"], status="open")
        [{'id': '...', 'title': 'Bug in login', ...}]
    """
```

