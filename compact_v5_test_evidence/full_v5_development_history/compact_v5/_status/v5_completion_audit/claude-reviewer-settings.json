{
  "disableAllHooks": true,
  "enabledPlugins": {
    "codex@openai-codex": false
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Grep(*)",
      "Glob(*)",
      "Bash(pwd)",
      "Bash(git status --short)",
      "Bash(git rev-parse HEAD)",
      "Bash(git diff --stat *)",
      "Bash(git show --stat *)",
      "Bash(rg *)",
      "Bash(py -3.11 *)"
    ],
    "deny": [
      "Edit(*)",
      "Write(*)",
      "NotebookEdit(*)",
      "Bash(codex *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)"
    ]
  }
}
