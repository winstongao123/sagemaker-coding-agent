table EnrollmentData
	lineageTag: 34b7a8fb-c203-5eee-9d34-b640516ab6d0

	measure 'Total Enquiries' = SUM(EnrollmentData[Enquiries])
		formatString: #,##0
		lineageTag: b15f11f6-fb71-507f-9b96-320190d6f476

	measure 'Total Applications' = SUM(EnrollmentData[Applications])
		formatString: #,##0
		lineageTag: 50ebffe7-788d-56b1-a332-a4babb9f6f0c

	measure 'Total Offers' = SUM(EnrollmentData[Offers])
		formatString: #,##0
		lineageTag: cc5ef2e5-7a1f-5499-bf75-5e5104543c02

	measure 'Total Acceptances' = SUM(EnrollmentData[Acceptances])
		formatString: #,##0
		lineageTag: e257ec0f-cf22-5b80-a3ac-c2e81c6987a9

	measure 'Total Enrollments' = SUM(EnrollmentData[Enrollments])
		formatString: #,##0
		lineageTag: f7e31632-6c51-5b00-b1b3-3424e9fab813

	measure 'Conversion Rate %' = DIVIDE([Total Enrollments], [Total Enquiries])
		formatString: #,##0.0"%"
		lineageTag: 2f79e82b-841b-5162-a3ef-191263e97072

	measure 'Offer Rate %' = DIVIDE([Total Offers], [Total Applications])
		formatString: #,##0.0"%"
		lineageTag: bd60964f-46e7-5e8d-a47a-704fd320be33

	measure 'Acceptance Rate %' = DIVIDE([Total Acceptances], [Total Offers])
		formatString: #,##0.0"%"
		lineageTag: 818c80b5-a7d3-5dc4-9279-6a4550ce6383

	measure 'Total Tuition' = SUM(EnrollmentData[Tuition])
		formatString: $#,##0
		lineageTag: 9f1f5cff-c928-5e13-ade9-24be8b346a6a

	measure 'Avg GPA' = AVERAGE(EnrollmentData[AvgGPA])
		formatString: #,##0.00
		lineageTag: 1ac67f0e-7020-5008-9b03-8ad96ad2158f

	measure 'Avg Satisfaction' = AVERAGE(EnrollmentData[SatisfactionScore])
		formatString: #,##0.00
		lineageTag: 01762435-cb37-579d-9809-8bd08b2b9f62

	measure 'Avg Retention %' = AVERAGE(EnrollmentData[RetentionPct])
		formatString: #,##0.0"%"
		lineageTag: 9f44e312-1e39-525f-a512-489f3006338e

	measure 'Avg International %' = AVERAGE(EnrollmentData[InternationalPct])
		formatString: #,##0.0"%"
		lineageTag: eb5f0115-42b8-5596-85dc-58237e1df5e7

