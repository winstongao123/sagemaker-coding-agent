				),
				CleanText = Table.TransformColumns(
					Source,
					{
						{"Faculty", each Text.Trim(_), type text},
						{"Campus", each Text.Trim(_), type text},
						{"CampusType", each Text.Trim(_), type text},
						{"Source", each Text.Trim(_), type text},
						{"StudyLevel", each Text.Trim(_), type text},
						{"Month", each Text.Trim(_), type text}
					}
				),
				FillMissingText = Table.ReplaceValue(CleanText, null, "Unknown", Replacer.ReplaceValue, {"Faculty", "Campus", "Source", "StudyLevel"}),
				NormalizeMetrics = Table.TransformColumns(
					FillMissingText,
					{
						{"SatisfactionScore", each if _ < 1 then 1 else if _ > 5 then 5 else _, type number},
						{"RetentionPct", each if _ < 0 then 0 else if _ > 100 then 100 else _, type number},
						{"InternationalPct", each if _ < 0 then 0 else if _ > 100 then 100 else _, type number}
					}
				),
				AddSortKey = Table.AddColumn(NormalizeMetrics, "YearMonthKey", each [Year] * 100 + [MonthNum], Int64.Type),
				SortRows = Table.Sort(AddSortKey, {{"YearMonthKey", Order.Ascending}, {"Faculty", Order.Ascending}}),
				DropHelper = Table.RemoveColumns(SortRows, {"YearMonthKey"}),
				FilterInvalid = Table.SelectRows(DropHelper, each [Enquiries] >= 0 and [Enrollments] >= 0)
			in
				FilterInvalid
