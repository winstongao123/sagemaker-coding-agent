table CampaignData
	lineageTag: 86093791-faf2-52a5-85fd-31ecf00f990b

	measure 'Total Spend' = SUM(CampaignData[Spend])
		formatString: $#,##0
		lineageTag: c10f72df-f9ff-5bd0-8b30-8981d1abec32

	measure 'Total Revenue' = SUM(CampaignData[Revenue])
		formatString: $#,##0
		lineageTag: a7a2a644-6bdf-5ad0-b4e5-ed46269ab93b

	measure 'Total Conversions' = SUM(CampaignData[Conversions])
		formatString: #,##0
		lineageTag: 5528f74c-6a74-5837-9f6a-914a2572191d

	measure 'Total Impressions' = SUM(CampaignData[Impressions])
		formatString: #,##0
		lineageTag: b2bea32e-58cc-5657-8339-aa1e75ebccee

	measure 'Total Clicks' = SUM(CampaignData[Clicks])
		formatString: #,##0
		lineageTag: 67148b22-401f-57a3-b217-27b56af7a9e7

	measure 'Total Leads' = SUM(CampaignData[Leads])
		formatString: #,##0
		lineageTag: 8ed3eec8-11d3-524f-86d2-0d911612c91c

	measure 'Conversion Rate' = DIVIDE(SUM(CampaignData[Conversions]), SUM(CampaignData[Clicks]))
		formatString: #,##0.0%
		lineageTag: 2f79e82b-841b-5162-a3ef-191263e97072

	measure 'Avg CPA' = DIVIDE(SUM(CampaignData[Spend]), SUM(CampaignData[Conversions]))
		formatString: $#,##0.00
		lineageTag: 81f148b9-4981-5689-a6e7-e0edcf1d1a5b

	measure 'Overall ROI' = DIVIDE(SUM(CampaignData[Revenue]) - SUM(CampaignData[Spend]), SUM(CampaignData[Spend]))
		formatString: #,##0.0%
		lineageTag: 8bf3796d-4187-5030-8c8a-7a573d49a255

	measure 'Click-Through Rate' = DIVIDE(SUM(CampaignData[Clicks]), SUM(CampaignData[Impressions]))
		formatString: #,##0.00%
		lineageTag: deb11cfc-8a34-5997-a913-fc08aeacc501

	measure 'Cost Per Click' = DIVIDE(SUM(CampaignData[Spend]), SUM(CampaignData[Clicks]))
		formatString: $#,##0.00
		lineageTag: 2eaaf8f8-e1eb-5972-9c3a-c00d3d5213b4

