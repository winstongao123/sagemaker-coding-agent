table WorkforceData
	lineageTag: 3cf5779f-d5f1-56f2-af35-5937de80203f

	measure 'Total Headcount' = SUM(WorkforceData[Headcount])
		formatString: #,##0
		lineageTag: a4d8d24f-4091-5766-ad99-f7bba5597d89

	measure 'Avg Salary' = AVERAGE(WorkforceData[Salary])
		formatString: $#,##0
		lineageTag: b5766ecb-7582-5f4b-a464-466b00ca2db9

	measure 'Avg Tenure' = AVERAGE(WorkforceData[TenureYears])
		formatString: #,##0.0
		lineageTag: 97199da8-4265-54d9-9a87-228d5028762f

	measure 'Total New Hires' = SUM(WorkforceData[NewHires])
		formatString: #,##0
		lineageTag: e8358fc7-f096-5de0-87e7-ee1d86862677

	measure 'Total Terminations' = SUM(WorkforceData[Terminations])
		formatString: #,##0
		lineageTag: c8018e19-1c4e-5631-8621-a7945264e92c

	measure 'Turnover Rate' = DIVIDE(SUM(WorkforceData[Terminations]), SUM(WorkforceData[Headcount]))
		formatString: #,##0.0%
		lineageTag: 18d573ed-c138-5a5d-ba8b-478ebbe45d8f

	measure 'Total Open Positions' = SUM(WorkforceData[OpenPositions])
		formatString: #,##0
		lineageTag: 5a233d57-53fd-5084-875e-e540c2ec3e76

	measure 'Avg Satisfaction' = AVERAGE(WorkforceData[SatisfactionScore])
		formatString: #,##0.0
		lineageTag: 01762435-cb37-579d-9809-8bd08b2b9f62

	measure 'Avg Training Hours' = AVERAGE(WorkforceData[TrainingHours])
		formatString: #,##0.0
		lineageTag: dd8a9b14-d75e-5aee-97bb-fdee539e3ad0

	measure 'Net Hire Rate' = DIVIDE(SUM(WorkforceData[NewHires]) - SUM(WorkforceData[Terminations]), SUM(WorkforceData[Headcount]))
		formatString: #,##0.0%
		lineageTag: b26a5b31-25de-535c-9405-95b60a459ef3

