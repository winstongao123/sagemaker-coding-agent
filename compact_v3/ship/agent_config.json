{
  // SageMaker Agent V3 Configuration
  // This file is optional. Delete or modify as needed.

  "model_id": "au.anthropic.claude-sonnet-4-5-20250929-v1:0",

  "skills_dir": "./skills",
  "enable_skills": true,

  // Sub-agent overrides: explore uses cheaper Haiku for file searching
  // NOTE: key must be "agents" (that's what the code reads from agent_config.json)
  "agents": {
    "explore": { "max_turns": 20, "model": "au.anthropic.claude-haiku-4-5-20251001-v1:0" },
    "review": { "max_turns": 20 },
    "general": { "max_turns": 25 }
  },

  // Custom slash commands (use /commands to list, /review <file> to run)
  "commands": {
    "review": {
      "template": "Review the following code for bugs, security issues, and improvements:\n$ARGUMENTS",
      "description": "Code review with best practices checklist",
      "agent": "plan"
    },
    "explain": {
      "template": "Explain this code in detail, including what it does, how it works, and any important patterns:\n$ARGUMENTS",
      "description": "Explain code in detail"
    },
    "test": {
      "template": "Write comprehensive tests for:\n$ARGUMENTS",
      "description": "Generate tests for code"
    }
  },

  // MCP servers (disabled by default - uncomment to enable)
  // "mcp": {
  //   "my-server": {
  //     "type": "local",
  //     "command": ["python", "mcp_server.py"],
  //     "env": {},
  //     "timeout": 30
  //   }
  // },

  // Permission overrides (uncomment to customize)
  // "permissions": {
  //   "bash": "ask",
  //   "python_exec": "ask",
  //   "read_file": "allow",
  //   "*.env": "deny"
  // }
}
